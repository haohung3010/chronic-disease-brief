  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Reading the brief",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#1C2A33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Prevalence is the share of the population who meet the case definition, counted for life for most conditions.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1C2A33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Age-standardized rates use one standard population, so an older province does not look sicker only because it is older. Use them to compare places and years.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1C2A33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "People living with it is a count, not a rate. It grows with ageing and population even when the rate is flat, and it is the number that sizes clinics and budgets.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1C2A33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1C2A33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What it cannot tell you",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#1C2A33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Administrative data see people who used care. Someone with undiagnosed diabetes, or treated only outside the insured system, is not counted. Definitions are validated per condition by PHAC.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1C2A33"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Blank years are years the province did not report; they are left blank, never filled.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1C2A33"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
